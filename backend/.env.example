# ============================================================================
# NAMMA VIVASAYI AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env in your backend directory or set these variables in
# your hosting provider dashboard (Render, Railway, Fly.io, etc.).
# NEVER commit your actual .env file or real secrets to Git!

# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Server network binding (Port is automatically assigned by Render/Railway via $PORT)
PORT=8000
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ----------------------------------------------------------------------------
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017
#
# For Hosted MongoDB Atlas (Free Tier Cluster):
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=namma_vivasayi_db

# ----------------------------------------------------------------------------
# 2. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g., your Vercel domain):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://namma-vivasayi.vercel.app
# Regular expression matching all Vercel preview deployments (*.vercel.app):
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ----------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ----------------------------------------------------------------------------
# Generate a strong 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_for_production
JWT_SECRET_KEY=change_me_to_a_separate_cryptographically_secure_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# 4. INITIAL PROCUREMENT STAFF PROVISIONING
# ----------------------------------------------------------------------------
# On first startup, the backend automatically provisions this authorized inspector:
STAFF_BOOTSTRAP_PHONE=9842012345
STAFF_BOOTSTRAP_PASSWORD=your_secure_staff_password_here
STAFF_BOOTSTRAP_NAME=Ramesh Kumar (Procurement Inspector)
STAFF_BOOTSTRAP_MANDI=Thanjavur Direct Procurement Centre #3 (Pillaiyarpatti)

# ----------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI ASSISTANT CONFIGURATION
# ----------------------------------------------------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# Recommended models: gemini-2.5-flash (default, multimodal, high-speed)
# Note: If rate-limited on free tier (429), the assistant automatically and
# transparently engages the verified TNAU rule-based agronomic fallback engine.
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# 6. SMS GATEWAY / TELEPHONY (OPTIONAL - UNCONFIGURED BY DEFAULT)
# ----------------------------------------------------------------------------
# For production SMS OTP verification (e.g., CDAC Gov SMS Gateway or Twilio).
# When unconfigured, farmer registration creates password-protected accounts with
# phone verification transparently disclosed as unverified (no simulated OTP).
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=TNDPC
SMS_DLT_TEMPLATE_ID=

# ----------------------------------------------------------------------------
# 7. DATA.GOV.IN MANDI MARKET PRICES CONFIGURATION
# ----------------------------------------------------------------------------
# Dataset: Current Daily Price of Various Commodities from Various Markets (Mandi)
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
# Register and generate an API key at: https://data.gov.in/
# If left empty, the backend operates in authenticated cache mode using validated
# government records with clear, honest source disclosures (no simulated data).
DATA_GOV_IN_API_KEY=

# Background refresh interval in minutes for querying data.gov.in (Default: 15 minutes)
# Note: This checks for newly published records; it does not force government boards to report faster.
MANDI_REFRESH_INTERVAL_MINUTES=15

# ----------------------------------------------------------------------------
# 8. WEB PUSH NOTIFICATIONS CONFIGURATION (VAPID)
# ----------------------------------------------------------------------------
# Generate VAPID keys using: npx web-push generate-vapid-keys
# If unconfigured, the system operates in in-app notification mode and
# honestly reports web push status as unconfigured in GET /api/notifications/push-status.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@nammavivasayi.tn.gov.in



